# COPY --from=lucky-build --chown=root:root /app/bin /app/bin
# COPY --from=lucky-build --chown=root:root /app/public /app/public

RUN chmod ug+x start_server

# Now copy our entrypoint stuff over
WORKDIR /

COPY containers/prod/api/entrypoint.sh .
RUN chmod +x entrypoint.sh

# Now build frontend assets
#
# First, blast away what's in the public folder
RUN rm -rf public/ && \
    mkdir public

WORKDIR /app/src/ts

RUN ~/.bun/bin/bun prod

