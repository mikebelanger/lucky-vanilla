FROM crystallang/crystal:1.19

# Install lucky cli
WORKDIR /lucky/cli
RUN git clone https://github.com/luckyframework/lucky_cli . && \
    git checkout v1.5.0 && \
    apt update && \
    apt install -y postgresql-client curl unzip && \
    shards build --without-development && \
    cp bin/lucky /usr/local/bin/lucky && \
    chmod +x /usr/local/bin/lucky && \
    curl -fsSL https://bun.sh/install | bash

# Now build the app
COPY . /app

WORKDIR /app

RUN shards install

# ENV ENABLE_KTLS=false

# RUN crystal build --static --release src/start_server.cr -o bin/start_server
RUN crystal build --release src/start_server.cr

# TODO - figure out how to get the above build files to run in a cleaner alpine distro

